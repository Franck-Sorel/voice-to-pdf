<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Recording in-app audio (P0 F1). Declared non-required so the app
         still installs on devices without a microphone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Opt-in telemetry + update checks (decision: allow opt-in INTERNET).
         The app stays 100% offline-functional; network is used ONLY for
         minimal, PII-free diagnostics when the user consents AND connectivity
         exists. See docs/NFR.md "Telemetry & privacy". -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:name=".STtApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoiceToPdf">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.VoiceToPdf">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
