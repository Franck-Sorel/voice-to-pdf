# Copy this file to keystore.properties (gitignored) and fill in real values.
# storeFile MUST be an absolute path to a release .jks/.keystore.
# Generate once:  keytool -genkeypair -v -keystore release.keystore \
#   -alias voicetopdf -keyalg RSA -keysize 2048 -validity 10000 -storetype PKCS12
# Keep this keystore backed up offline FOREVER — losing it means you can never
# update sideloaded installs (and, if reused, Play uploads).
storeFile=/absolute/path/to/release.keystore
storePassword=change-me
keyAlias=voicetopdf
keyPassword=change-me
